# ==============================================================================
# Indicative — Environment Configuration Example
# Copy to .env and replace placeholder values. NEVER commit real secrets.
# ==============================================================================

# --- Runtime Environment ---
NODE_ENV=development
LOG_LEVEL=info

# Strictly restricted to NODE_ENV=development. Refuses to start in production.
# Enables local demo login and local fixture repository scanning for evaluation.
DEMO_MODE=true

# --- Service URLs & Ports ---
API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- PostgreSQL Database ---
DATABASE_URL=postgresql://indicative:indicative_dev_password@localhost:5432/indicative

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379

# --- S3-Compatible Artifact Storage (MinIO for local dev) ---
ARTIFACT_STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=indicative-artifacts
S3_ACCESS_KEY_ID=indicative_minio
S3_SECRET_ACCESS_KEY=indicative_minio_secret_dev
S3_FORCE_PATH_STYLE=true
ARTIFACT_RETENTION_DAYS=30

# --- Cryptographic Keys (Generate >= 32 random hex/base64 bytes for non-dev) ---
# Used to sign OAuth state, CSRF tokens, and session cookies
SESSION_SECRET=dev-only-replace-with-64-char-random-hex-string-0123456789abcdef
# Root key for tenant-scoped HKDF + HMAC-SHA256 secret fingerprinting (never plaintext)
SECRET_FINGERPRINT_KEY=dev-only-replace-with-64-char-hmac-master-key-fedcba9876543210
# Internal shared bearer token between worker and isolated scanner-runner service
SCANNER_RUNNER_SHARED_SECRET=dev-only-scanner-runner-internal-token-change-in-prod

# --- GitHub OAuth (User Authentication) ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback

# --- GitHub App (Repository Read-Only Authorization & Short-Lived Tokens) ---
GITHUB_APP_ID=
GITHUB_APP_SLUG=indicative-security
# Base64-encoded PEM private key (or multiline escaped \n)
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_WEBHOOK_POST_PR_COMMENTS=true
GITHUB_WEBHOOK_CREATE_CHECK_RUNS=true

# --- Scheduled Scans & Notifications ---
ENABLE_SCHEDULER=true
SCHEDULER_POLL_INTERVAL_MS=60000
NOTIFICATION_TIMEOUT_MS=10000

# --- Isolated Scanner Runner ---
# Mode: "http" (calls isolated scanner-runner container) or "local" (local runner process)
SCANNER_RUNNER_MODE=http
# Sandbox runtime label: "local-process" | "docker" | "gvisor" | "kata"
# Use infrastructure/sandbox/docker-compose.gvisor.yml for gVisor (runsc) multi-tenant isolation
SCANNER_SANDBOX_RUNTIME=docker
SCANNER_RUNNER_URL=http://scanner-runner:4100
SCANNER_RUNNER_HOST=0.0.0.0
SCANNER_RUNNER_PORT=4100
SCANNER_WORKSPACES_ROOT=/tmp/indicative-workspaces
# Maximum raw JSON output bytes accepted per scanner before failing with RESOURCE_LIMIT (default 64 MB)
SCANNER_MAX_REPORT_BYTES=67108864
# Pinned scanner binary paths (override for custom host installations)
SEMGREP_BIN=semgrep
TRIVY_BIN=trivy
GITLEAKS_BIN=gitleaks
# Offline Trivy vulnerability DB & checks cache directory
TRIVY_CACHE_DIR=/var/cache/trivy
# Pinned bundled Semgrep ruleset path
SEMGREP_RULES_DIR=/app/services/scanner-runner/rules/semgrep

# --- Cost, Resource & Scan Execution Limits ---
MAX_REPO_SIZE_MB=250
MAX_FILES_PER_SCAN=25000
MAX_SCAN_DURATION_MS=300000
SCANNER_TIMEOUT_MS=120000
MAX_CONCURRENT_SCANS_PER_ORG=3
WORKER_CONCURRENCY=2
MAX_GIT_HISTORY_COMMITS=5000

# --- AI Security Analyst (Optional — deterministic scanning works without this) ---
# Supported: "disabled" | "openai-compatible"
AI_PROVIDER=disabled
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_CONTEXT_CHARS=12000
AI_MAX_TOKENS=1200
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
